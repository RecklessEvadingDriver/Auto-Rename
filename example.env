# Auto-Rename Bot Configuration
# Copy this file to .env and fill in your values

# ===== REQUIRED SETTINGS =====

# Telegram API credentials (get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# MongoDB connection string (get free tier from https://www.mongodb.com/cloud/atlas)
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/

# Your Telegram user ID (get from @userinfobot)
OWNER_ID=123456789

# Log channel ID (create a channel and add bot as admin)
LOG_CHANNEL=-1001234567890

# ===== OPTIONAL SETTINGS =====

# Support chat/group ID
SUPPORT_CHAT=-1001234567890

# Database name (default: RexBots)
DB_NAME=RexBots

# Web server port (default: 8980)
PORT=8980

# Enable webhook for hosting platforms (default: True)
WEBHOOK=True

# Bot username (without @)
BOT_USERNAME=YourBotUsername

# Channel for file dumps
DUMP_CHANNEL=-1001234567890

# Custom images (optional)
START_PIC=https://example.com/start.jpg
LEADERBOARD_PIC=https://example.com/leaderboard.jpg
FSUB_PIC=https://example.com/fsub.jpg
